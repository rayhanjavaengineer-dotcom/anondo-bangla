rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
    function validStoryVideo() {
      return request.resource != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    match /users/{uid}/avatar/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(uid) && validImage();
      allow delete: if isOwner(uid);
    }
    match /posts/{uid}/public/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(uid) && (validImage() || validStoryVideo());
      allow delete: if isOwner(uid);
    }
    match /posts/{uid}/private/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && (validImage() || validStoryVideo());
      allow delete: if isOwner(uid);
    }
    match /stories/{uid}/public/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(uid) && (validImage() || validStoryVideo());
      allow delete: if isOwner(uid);
    }
    match /stories/{uid}/private/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && (validImage() || validStoryVideo());
      allow delete: if isOwner(uid);
    }
  }
}
